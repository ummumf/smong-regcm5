#Installation RegCM5

# load module
module load oneapi/tbb
module load oneapi/compiler-rt
module load oneapi/umf
module load oneapi/compiler-intel-llvm/latest
module load oneapi/mpi
ml load hwloc
ml load prun
ml load ucx

source /software/compilers/intel-oneapi/2025.2.1/setvars.sh
# export env
export CC=icx
export CXX=icpx
export FC=ifx
export F77=ifx
export F90=ifx
export MPIFC=mpiifx
export MPIF77=mpiifx
export MPIF90=mpiifx
export MPICC=mpiicx
export MPICXX=mpiicpx
export CFLAGS="-fPIC -fPIE -O3 -Wno-implicit-function-declaration -Wno-incompatible-function-pointer-types -Wno-incompatible-function-pointer-types -Wno-unused-command-line-argument"
export FFLAGS=""
export FCFLAGS=""
export CXXFLAGS="-Wall -DHAVE_ISATTY"
export DIR=/home/ummu/libraries

# Instal libraries
# Zlib 
wget -c https://github.com/madler/zlib/releases/download/v1.3.1/zlib-1.3.1.tar.gz
CC=mpiicx FC=mpiifx F77=mpiifx F90=mpiifx CXX=mpiicpx ./configure --prefix=$DIR
make
make install

# HDF5 (1.14.6)
wget -c https://github.com/HDFGroup/hdf5/releases/download/hdf5_$HDF5_Version/hdf5-1.14.6.tar.gz
export CFLAGS="-O3 -fPIC -Wno-unused-command-line-argument -Wno-implicit-function-declaration -Wno-incompatible-function-pointer-types"
export LDFLAGS="-L$DIR/lib -Wl,-rpath,$DIR/lib"
CC=mpiicx FC=mpiifx F77=mpiifx F90=mpiifx CXX=mpiicpx ./configure --prefix=$DIR --with-zlib=$DIR --enable-hl --enable-fortran --enable-parallel
make
make install

# Parallel-NetCDF (1.14.1)
wget -c https://parallel-netcdf.github.io/Release/pnetcdf-1.14.1.tar.gz
CC=mpiicx FC=mpiifx F77=mpiifx F90=mpiifx CXX=mpiicpx ./configure --prefix=$DIR --enable-static
make
make install

# NetCDF-C (4.9.3)
wget -c https://github.com/Unidata/netcdf-c/archive/refs/tags/v4.9.3.tar.gz
export CPPFLAGS=-I$DIR/include
export LDFLAGS="-L$DIR/lib -Wl,-rpath,$DIR/grib2/lib"
export LIBS="-lhdf5_hl -lhdf5 -lz -lcurl -lgfortran -lgcc -lm -ldl -lpnetcdf"
CC=mpiicx FC=mpiifx F77=mpiifx F90=mpiifx CXX=mpiicpx \
./configure --prefix= $DIR--disable-dap --enable-netcdf-4 --enable-netcdf4 --enable-pnetcdf --enable-cdf5 --enable-parallel-tests --enable-logging
make
make install

# NetCDF-Fortran (4.6.2)
wget -c https://github.com/Unidata/netcdf-fortran/archive/refs/tags/v4.6.2.tar.gz
export LD_LIBRARY_PATH=$DIR/lib:$LD_LIBRARY_PATH
export HDF5_PLUGIN_PATH=$DIR/hdf5/lib/plugin
export CPPFLAGS="-I$DIR/include -I$DIR/include"
export LDFLAGS="-L$DIR/lib -L$DIR/lib -Wl,-rpath,$DIR/lib -Wl,-rpath,$DIR/lib"
export LIBS="-lnetcdf -lpnetcdf -lcurl -lhdf5_hl -lhdf5 -lz -lm -ldl -lgcc -lgfortran"
CC=mpiicx FC=mpiifx CXX=mpiicpx F90=mpiifx F77=mpiifx \
./configure --prefix=$DIR --enable-netcdf-4 --enable-netcdf4 --enable-parallel-tests --enable-logging --enable-hdf5

# >>> RegCM / NetCDF Intel setup >>>
export PREFIX=/home/ummu/libraries
export PATH=$PREFIX/bin:$PATH
export LD_LIBRARY_PATH=$PREFIX/lib:$LD_LIBRARY_PATH
export CPATH=$PREFIX/include:$CPATH
export NETCDF=$PREFIX
export NETCDFF=$PREFIX
# Intel compilers
export CC=mpiicx
export FC=mpiifx
export F77=mpiifx
export CXX=mpiicpx
# Disable LTO (VERY IMPORTANT)
export CFLAGS="-O2 -fno-lto"
export FCFLAGS="-O2 -fno-lto"
export CPPFLAGS="-I$PREFIX/include"
export LDFLAGS="-L$PREFIX/lib"

#RegCM5
git clone https://github.com/ICTP/RegCM.git
bash bootstrap.sh
./configure --enable-clm45 --with-netcdf=$PREFIX
make
make install

